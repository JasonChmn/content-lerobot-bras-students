# Copy to .env: pixi run launch and pixi run doctor read it.
# Serial port of the follower arm, from lerobot-find-port. Linux: its /dev/serial/by-id/ name (pixi run doctor shows it).
SO101_PORT=
# Calibration file written by lerobot-calibrate.
SO101_CALIBRATION_FILE=
# Camera index, or /dev/videoN on Linux, from lerobot-find-cameras.
SO101_CAMERA_DEVICE=0
